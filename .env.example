# =========================================================
# DeepResearch Agent 配置示例
# 复制为 .env 后按需填写。禁止把 API Key 提交到代码库。
# =========================================================

# ---------- LangSmith 观测性（可选） ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepresearch-agent

# ---------- LLM 提供商（默认 DeepSeek） ----------
LLM_PROVIDER=deepseek            # deepseek / openai / anthropic / qwen / ollama / mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

DASHSCOPE_API_KEY=               # Qwen 模型与 DashScope Embedding 共用
QWEN_MODEL=qwen-plus

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------- 搜索 ----------
SEARCH_PROVIDER=duckduckgo       # duckduckgo(免key) / tavily
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ---------- Embedding / 向量库 ----------
EMBEDDING_PROVIDER=mock          # dashscope / openai / ollama / mock(测试兜底)
EMBEDDING_MODEL=text-embedding-v3
VECTOR_BACKEND=memory            # auto / qdrant / memory（未装 qdrant-client 时自动回退内存）
QDRANT_URL=                      # 远程 Qdrant，留空使用本地文件模式
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=research_documents

# ---------- 记忆 / 存储 ----------
MEMORY_BACKEND=sqlite            # sqlite / postgres
DATABASE_URL=                    # 例: postgresql://user:pass@localhost:5432/db
SQLITE_PATH=data/deepresearch.db

# ---------- Agent 运行参数 ----------
MAX_ITERATIONS=8
SUFFICIENCY_THRESHOLD=0.6
CONTEXT_MAX_TOKENS=8000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
